<div class="max-w-md mx-auto p-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">New bookmark</h1>

  <%= form_with model: @bookmark, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :title,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= form.label :url, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :url,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="flex items-center gap-3">
      <%= form.submit "Save",
          class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium cursor-pointer" %>
      <%= link_to "Cancel", bookmarks_path, class: "text-gray-600 hover:text-gray-800" %>
    </div>
  <% end %>
</div>
